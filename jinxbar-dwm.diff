+/*
+ * Status text escapes (status2d-compatible subset):
+ *   ^c#rrggbb^  foreground     ^b#rrggbb^  background     ^d^  reset colours
+ *   ^f<n>^      skip n px      ^r<x>,<y>,<w>,<h>^  filled rect in fg colour
+ * The status may hold two parts separated by '\x1f': "centre\x1fright".
+ * With draw == 0 it only measures and returns the width in px.
+ */
+int
+drawstatus(int x, char *s, int draw)
+{
+	char *p, *end, c;
+	int w = 0, cw, rx, ry, rw, rh;
+	Clr sc[3];
+
+	memcpy(sc, scheme[SchemeNorm], sizeof sc);
+	if (draw)
+		drw_setscheme(drw, sc);
+	while (*s) {
+		for (p = s; *p && *p != '^'; p++);
+		c = *p;
+		*p = '\0';
+		if (*s) {
+			cw = drw_fontset_getwidth(drw, s);
+			if (draw)
+				drw_text(drw, x + w, 0, cw, bh, 0, s, 0);
+			w += cw;
+		}
+		*p = c;
+		if (!c || !(end = strchr(p + 1, '^')))
+			break;
+		*end = '\0';
+		switch (p[1]) {
+		case 'c': if (draw) drw_clr_create(drw, &sc[ColFg], p + 2); break;
+		case 'b': if (draw) drw_clr_create(drw, &sc[ColBg], p + 2); break;
+		case 'd': if (draw) memcpy(sc, scheme[SchemeNorm], sizeof sc); break;
+		case 'f': w += atoi(p + 2); break;
+		case 'r':
+			if (draw && sscanf(p + 2, "%d,%d,%d,%d", &rx, &ry, &rw, &rh) == 4)
+				drw_rect(drw, x + w + rx, ry, rw, rh, 1, 0);
+			break;
+		}
+		*end = '^';
+		s = end + 1;
+	}
+	drw_setscheme(drw, scheme[SchemeNorm]);
+	return w;
+}
